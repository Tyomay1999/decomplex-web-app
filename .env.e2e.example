# E2E harness (Playwright)
E2E_BASE_URL=http://localhost:3100
E2E_WEB_PORT=3100
E2E_LOCALE=en

# App runtime config used by E2E server
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4100/api
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_STATIC_EXPORT=false

# Optional test user creds (use local overrides)
E2E_TEST_USER_EMAIL=e2e.user@example.com
E2E_TEST_USER_PASSWORD=Passw0rd!123

# Optional backend utilities (for deterministic e2e)
E2E_BACKEND_HEALTH_URL=http://127.0.0.1:4100/health
E2E_BACKEND_RESET_URL=