{
  "name": "decomplex-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "dev": "next dev",
    "export": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck",
    "fix": "npm run lint:fix && npm run format",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "dotenv -e .env.e2e -- playwright test",
    "e2e:ui": "dotenv -e .env.e2e -- playwright test --ui",
    "e2e:real": "dotenv -e .env.e2e -- playwright test --project=e2e-real",
    "e2e:mocked": "dotenv -e .env.e2e -- playwright test --project=e2e-mocked",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.1",
    "next": "16.0.8",
    "next-intl": "^4.6.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.8",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "prettier": "^3.7.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.49.0",
    "vitest": "^2.0.5"
  }
}
